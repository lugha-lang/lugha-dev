# .llmignore
# Files and directories the AI must never touch.
# Keep this in sync with the PROTECTED FILES section in CLAUDE.md and the
# permissions.deny list in .claude/settings.json.

# Environment and secrets
.env
.env.*

# ../lugha may be changed from here, by its own CLAUDE.md (owner, 2026-11-20);
# its protected files stay out of reach
../lugha/.env
../lugha/.env.*
../lugha/Cargo.lock
../lugha/target/
../lugha/LICENSE

# Sibling repositories: their own rules apply; read for reference, never write
../rapidkoi/
../rapidkoi-rust/
../kivuli/
../lugha-gtk/
../lugha-wasmtime/
../lugha-cbor/
../lugha-sqlite/
../lugha-imagesize/
../glowworm/
../firefly/
