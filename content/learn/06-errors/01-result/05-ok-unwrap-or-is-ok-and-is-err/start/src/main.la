fun divide(a: i64, b: i64): Result<i64, string> {
    if b == 0 {
        return Err("division by zero");
    }
    Ok(a / b)
}

fun main(console: Console) {
    let good = divide(10, 2);
    let bad = divide(1, 0);
    console.println(good.ok().debug());
    console.println(bad.ok().debug());
    console.println(good.unwrap_or(0));
    console.println(bad.unwrap_or(0));
    console.println(good.is_ok());
    console.println(bad.is_err());
}
