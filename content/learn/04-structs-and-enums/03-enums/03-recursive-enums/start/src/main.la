enum List {
    Nil,
    Cons(i64, List),
}

fun sum(list: List): i64 {
    match list {
        .Nil => 0,
        .Cons(head, rest) => head + sum(rest),
    }
}

fun main(console: Console) {
    let numbers = List.Cons(1, List.Cons(2, List.Cons(3, List.Nil)));
    console.println(numbers.debug());
    console.println(sum(numbers));
}
