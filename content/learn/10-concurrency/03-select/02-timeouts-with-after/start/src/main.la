import std.task;

fun slow(c: Chan<string>) {
    task.sleep(500);
    c.send("done");
}

fun main() {
    let c: Chan<string> = Chan.new();
    spawn slow(c);
    let mut waiting = true;
    while waiting {
        select {
            m = c.recv() => {
                println(m.unwrap());
                waiting = false;
            },
            after(200) => println("still waiting"),
        }
    }
}
