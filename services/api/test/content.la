// The content checks: every lesson step and every example
// in content/ runs through the real sandbox, exactly as a visitor's code
// would, and must print what its expected.txt says. A step with a solution
// is checked both ways: the start code gives its start_error (or prints its
// start_output), and the solution prints expected.txt. A step runs with every
// file under its start/ (or solution/), its own lugha.toml included. A step with tests (test/ files, or an @test anywhere) is a test
// step: its solution's tests must all pass, and a start with start_failing
// must fail exactly those tests.
//
// Home's card (content/home) and the Playground's opening program
// (content/playground) are checked the same way.
//
// Integration tests: they start Docker and read the content folder, so they
// run only when asked, like the hostile suite:
//   scripts/content
// CONTENT_DIR names the content folder (default ../../content, from services/api).
import std.json;
import std.toml;
import api.checks.files { File };
import api.checks.manifest { DEFAULT };
import api.checks.requests { RunRequest, files_request, reason };
import api.checks.job { run_job, files_job, files_value };
import api.server.sandbox { Host, run_in_sandbox };

/** The runner's path inside the sandbox image. */
const RUNNER: string = "/usr/local/bin/runner";

/** What the checks use: the sandbox image, how to start it, and the content folder, read-only. */
struct Setup {
    host: Host,
    image: string,
    content: ReadDir,
}

/**
 * `net` is never called: holding it keeps v18's lockdown from refusing the
 * socket `docker` talks to its daemon through.
 *
 * Gives the setup when the checks were asked for (SANDBOX_TESTS=1), Docker
 * has runsc, the sandbox image is built and the content folder opens.
 */
fun setup(env: Env, fs: Fs, proc: Proc, net: Net, clock: Clock, entropy: Entropy): Option<Setup> {
    if env.get("SANDBOX_TESTS") != Some("1") {
        return None;
    }
    let image = env.get("SANDBOX_IMAGE").unwrap_or("lugha-sandbox:m240");
    let has_runsc = match proc.run("docker", ["info", "--format", "{{{{json .Runtimes}}}}"]) {
        .Ok(out) => out.stdout.contains("\"runsc\""),
        .Err(_) => false,
    };
    let has_image = match proc.run("docker", ["image", "inspect", image]) {
        .Ok(out) => out.code == 0,
        .Err(_) => false,
    };
    if !has_runsc || !has_image {
        return None;
    }
    let content = fs.dir(env.get("CONTENT_DIR").unwrap_or("../../content")).ok()?;
    Some(Setup {
        host: Host { proc: proc, clock: clock, entropy: entropy },
        image: image,
        content: content.read_only(),
    })
}

/** What one run gave: its compile error code (or ""), and its stdout. */
struct Ran {
    error: string,
    stdout: string,
}

/** Runs `source` as src/main.la with `stdin`, as the API would. */
fun run(s: Setup, source: string, stdin: string): Result<Ran, string> = run_files(
    s,
    [File { path: "src/main.la", text: source }],
    stdin,
);

/** Runs a project's files, with src/main.la as the entry, and the default lugha.toml unless it has its own. */
fun run_files(s: Setup, project: File[], stdin: string): Result<Ran, string> {
    let mut all = project;
    if !all.any(fun(f) = f.path == "lugha.toml") {
        all.push(File { path: "lugha.toml", text: DEFAULT });
    }
    let r = RunRequest { files: all, entry: "src/main.la", args: [], stdin: stdin, opt: 0 };
    let v = run_in_sandbox(s.host, s.image, [RUNNER], run_job(r)).map_err(fun(e) = e.debug())?;
    // A step may show a warning on purpose (W0107 for `017`), so only an
    // error-severity diagnostic counts as the step's error.
    let diagnostics = json.get(v, "compile").and_then(fun(c) = json.get(c, "diagnostics")).and_then(
        json.as_array,
    ).unwrap_or([]);
    let mut error = "";
    for d of diagnostics {
        let severity = json.get(d, "severity").and_then(json.as_text).unwrap_or("");
        if error == "" && severity == "error" {
            error = json.get(d, "code").and_then(json.as_text).unwrap_or("");
        }
    }
    let stdout = json.get(v, "program").and_then(fun(p) = json.get(p, "stdout")).and_then(
        json.as_text,
    ).unwrap_or("");
    Ok(Ran { error: error, stdout: stdout })
}

/** What one Test gave: the tests that failed (by function name, sorted), how many passed, and whether they compiled. */
struct Tested {
    failed: string[],
    passed: i64,
    compiled: bool,
}

/** Runs a project's tests, as the API's Test would. */
fun test_files(s: Setup, project: File[]): Result<Tested, string> {
    let body = json.stringify(json.Value.Object(Map { "files": files_value(project) })).unwrap();
    let c = files_request(body).map_err(reason)?;
    let v = run_in_sandbox(s.host, s.image, [RUNNER], files_job("test", c)).map_err(
        fun(e) = e.debug(),
    )?;
    let mut failed: string[] = [];
    let mut passed = 0;
    for t of json.get(v, "tests").and_then(json.as_array).unwrap_or([]) {
        let status = json.get(t, "status").and_then(json.as_text).unwrap_or("");
        if status == "passed" {
            passed += 1;
        } else if status == "failed" {
            // The API names a test by its module too ("test.area.area_of_three");
            // a step names it by its function alone.
            let full = json.get(t, "test").and_then(json.as_text).unwrap_or("");
            let parts = full.split(".");
            failed.push(parts[parts.len - 1]);
        }
    }
    let compiled = json.get(v, "compile_error").and_then(json.as_text).is_none();
    Ok(Tested { failed: failed.sort(), passed: passed, compiled: compiled })
}

/** The test names in a start_failing value, sorted. */
fun names(list: string): string[] = list.split(",").map(fun(n) = n.trim()).filter(
    fun(n) = n != "",
).sort();

/**
 * Compares a Test with what was expected: every test passing when `failing`
 * is empty, otherwise exactly those tests failing.
 */
fun check_tests(
    problems: string[],
    what: string,
    got: Result<Tested, string>,
    failing: string[],
): string[] {
    let mut out = problems;
    match got {
        .Err(e) => out.push("{what}: no result ({e})"),
        .Ok(t) => {
            if !t.compiled {
                out.push("{what}: the tests didn't compile");
            } else if failing.len == 0 && (t.failed.len > 0 || t.passed == 0) {
                out.push(
                    "{what}: expected every test to pass; failed {t.failed.debug()}, passed {t.passed}",
                );
            } else if failing.len > 0 && t.failed != failing {
                out.push("{what}: expected {failing.debug()} to fail, failed {t.failed.debug()}");
            }
        }
    }
    out
}

/** Every file under `dir`, by its path from `dir` ("src/main.la"). */
fun project(content: ReadDir, dir: string): File[] {
    let mut out: File[] = [];
    let mut todo = [""];
    while let .Some(rel) = todo.pop() {
        let here = if rel == "" { dir } else { "{dir}/{rel}" };
        for name of content.list(here).unwrap_or([]) {
            let child = if rel == "" { name } else { "{rel}/{name}" };
            if content.is_dir("{dir}/{child}") {
                todo.push(child);
            } else {
                out.push(File {
                    path: child,
                    text: content.read_file("{dir}/{child}").unwrap_or(""),
                });
            }
        }
    }
    out
}

/** The folders in `path`, sorted (list_dir sorts). */
fun folders(content: ReadDir, path: string): string[] = content.list(path).unwrap_or([]).filter(
    fun(n) = content.is_dir("{path}/{n}"),
);

/**
 * Reads a key's value from a step's front matter (between the --- lines at
 * the top of its Markdown), with one pair of quotes removed and `\n` turned
 * into a newline; "" if absent.
 */
fun front(md: string, key: string): string {
    let lines = md.lines();
    if lines.len == 0 || lines[0] != "---" {
        return "";
    }
    for i in 1..lines.len {
        let line = lines[i];
        if line == "---" {
            return "";
        }
        if line.starts_with("{key}:") {
            let mut v = line.slice(key.len + 1, line.len).trim();
            if v.len >= 2 && v.starts_with("\"") && v.ends_with("\"") {
                v = v.slice(1, v.len - 1);
            }
            return v.split("\\n").join("\n");
        }
    }
    ""
}

/** Whether a project has tests: a file under `test/`, or a line starting `@test` in any file. */
fun has_tests(sources: File[]): bool = sources.any(
    fun(f) = f.path.starts_with("test/") || f.text.split("\n").any(
        fun(l) = l.trim().starts_with("@test"),
    ),
);

/** Compares what ran with what was expected, adding a line to `problems` when they differ. */
fun check(
    problems: string[],
    what: string,
    got: Result<Ran, string>,
    error: string,
    stdout: string,
): string[] {
    let mut out = problems;
    match got {
        .Err(e) => out.push("{what}: no result ({e})"),
        .Ok(r) => {
            if error != "" && r.error != error {
                out.push(
                    "{what}: expected {error}, got {if r.error == "" { "no error" } else { r.error }}",
                );
            }
            if error == "" && r.error != "" {
                out.push("{what}: didn't compile ({r.error})");
            }
            if error == "" && r.stdout != stdout {
                out.push("{what}: printed\n{r.stdout}--- expected\n{stdout}---");
            }
        }
    }
    out
}

@test(integration)
fun every_lesson_step_prints_what_it_says(
    console: Console,
    env: Env,
    fs: Fs,
    proc: Proc,
    net: Net,
    clock: Clock,
    entropy: Entropy,
) {
    let s = setup(env, fs, proc, net, clock, entropy).expect(
        "set SANDBOX_TESTS=1, with runsc, the sandbox image and the content folder",
    );
    let c = s.content;
    let mut problems: string[] = [];
    let mut steps = 0;
    let learn = "learn";
    for chapter of folders(c, learn) {
        for lesson of folders(c, "{learn}/{chapter}") {
            for step of folders(c, "{learn}/{chapter}/{lesson}") {
                let dir = "{learn}/{chapter}/{lesson}/{step}";
                let md = c.read_file("{dir}/step.md").expect("every step has step.md");
                let expected = c.read_file("{dir}/expected.txt").expect(
                    "every step has expected.txt",
                );
                let start = project(c, "{dir}/start");
                let tests = has_tests(start);
                steps += 1;
                if c.is_dir("{dir}/solution") {
                    let solution = project(c, "{dir}/solution");
                    problems = check(
                        problems,
                        "{step} (solution)",
                        run_files(s, solution, ""),
                        "",
                        expected,
                    );
                    if tests {
                        problems = check_tests(
                            problems,
                            "{step} (solution's tests)",
                            test_files(s, solution),
                            [],
                        );
                    }
                    let failing = front(md, "start_failing");
                    if failing != "" {
                        problems = check_tests(
                            problems,
                            "{step} (start's tests)",
                            test_files(s, start),
                            names(failing),
                        );
                    } else {
                        problems = check(
                            problems,
                            "{step} (start)",
                            run_files(s, start, ""),
                            front(md, "start_error"),
                            front(md, "start_output"),
                        );
                    }
                } else {
                    problems = check(problems, step, run_files(s, start, ""), "", expected);
                    if tests {
                        problems = check_tests(
                            problems,
                            "{step} (tests)",
                            test_files(s, start),
                            [],
                        );
                    }
                }
            }
        }
    }
    assert(steps > 0);
    for p of problems {
        console.eprintln(p);
    }
    assert_eq(problems, []);
}

@test(integration)
fun every_example_prints_what_it_says(
    console: Console,
    env: Env,
    fs: Fs,
    proc: Proc,
    net: Net,
    clock: Clock,
    entropy: Entropy,
) {
    let s = setup(env, fs, proc, net, clock, entropy).expect(
        "set SANDBOX_TESTS=1, with runsc, the sandbox image and the content folder",
    );
    let c = s.content;
    let mut problems: string[] = [];
    let examples = "examples";
    let names = folders(c, examples);
    assert(names.len > 0);
    for name of names {
        let dir = "{examples}/{name}";
        let meta = toml.parse(
            c.read_file("{dir}/example.toml").expect("every example has example.toml"),
        ).expect("example.toml is TOML");
        let stdin = toml.get(meta, "stdin").and_then(toml.as_text).unwrap_or("");
        let source = c.read_file("{dir}/src/main.la").expect("every example has src/main.la");
        let expected = c.read_file("{dir}/expected.txt").expect("every example has expected.txt");
        problems = check(problems, name, run(s, source, stdin), "", expected);
    }
    for p of problems {
        console.eprintln(p);
    }
    assert_eq(problems, []);
}

@test(integration)
fun home_and_playground_programs_print_what_they_say(
    console: Console,
    env: Env,
    fs: Fs,
    proc: Proc,
    net: Net,
    clock: Clock,
    entropy: Entropy,
) {
    let s = setup(env, fs, proc, net, clock, entropy).expect(
        "set SANDBOX_TESTS=1, with runsc, the sandbox image and the content folder",
    );
    let c = s.content;
    let mut problems: string[] = [];
    for name of ["home", "playground"] {
        let dir = name;
        let source = c.read_file("{dir}/src/main.la").expect("the program is src/main.la");
        let expected = c.read_file("{dir}/expected.txt").expect("the program has expected.txt");
        problems = check(problems, name, run(s, source, ""), "", expected);
    }
    for p of problems {
        console.eprintln(p);
    }
    assert_eq(problems, []);
}

@test
fun a_test_file_makes_tests() {
    assert(has_tests([File { path: "test/area.la", text: "" }]));
}

@test
fun an_at_test_in_src_makes_tests() {
    assert(
        has_tests([
            File { path: "src/main.la", text: "fun main() {{}}\n\n@test\nfun works() {{}}\n" },
        ]),
    );
}

@test
fun no_at_test_makes_no_tests() {
    assert(
        !has_tests([
            File { path: "src/main.la", text: "// @test in a comment\nfun main() {{}}\n" },
        ]),
    );
}
