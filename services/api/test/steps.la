// The commands the runner runs inside the container: argument lists, never a shell.
import api.runner.steps {
    Command,
    build_command,
    run_command,
    test_command,
    format_command,
    PROGRAM,
};

@test
fun building_is_timed_and_gives_json_diagnostics() {
    assert_eq(build_command("src/main.la", 2), Command {
        cmd: "timeout",
        args: [
            "--kill-after=2",
            "30",
            "lughac",
            "build",
            "--diagnostics",
            "json",
            "-O",
            "2",
            "src/main.la",
            "-o",
            PROGRAM,
        ],
    });
}

@test
fun running_is_timed_and_limited() {
    assert_eq(run_command(["21", "--verbose"]), Command {
        cmd: "timeout",
        args: [
            "--kill-after=1",
            "5",
            "prlimit",
            "--as=268435456",
            "--nproc=16",
            "--fsize=16777216",
            "--",
            "env",
            "LUGHA_WORKERS=1",
            PROGRAM,
            "21",
            "--verbose",
        ],
    });
}

@test
fun the_program_lives_where_no_sent_file_can() {
    // Sent files are lugha.toml or under src/ and test/, with plain names:
    // a path starting with "." can't be one of them.
    assert(PROGRAM.starts_with("./.build/"));
}

@test
fun an_argument_like_a_flag_reaches_the_program() {
    // After "--", prlimit passes everything on unread, and env reads
    // nothing after the program's name.
    let c = run_command(["--as=0", "-i"]);
    let n = c.args.len;
    assert_eq(
        [c.args[n - 6], c.args[n - 5], c.args[n - 4], c.args[n - 3], c.args[n - 2], c.args[n - 1]],
        ["--", "env", "LUGHA_WORKERS=1", PROGRAM, "--as=0", "-i"],
    );
}

@test
fun an_argument_like_a_setting_reaches_the_program() {
    let c = run_command(["LUGHA_WORKERS=8"]);
    assert_eq(c.args[c.args.len - 2], PROGRAM);
    assert_eq(c.args[c.args.len - 1], "LUGHA_WORKERS=8");
}

@test
fun testing_runs_every_test_with_json_output() {
    assert_eq(test_command(), Command {
        cmd: "timeout",
        args: [
            "--kill-after=2",
            "40",
            "lughac",
            "test",
            "--json",
            "--diagnostics=json",
            "--timeout",
            "5",
            ".",
        ],
    });
}

@test
fun formatting_names_each_file() {
    assert_eq(format_command(["src/main.la", "test/main_test.la"]), Command {
        cmd: "timeout",
        args: [
            "--kill-after=2",
            "30",
            "lughac",
            "fmt",
            "--diagnostics=json",
            "src/main.la",
            "test/main_test.la",
        ],
    });
}
