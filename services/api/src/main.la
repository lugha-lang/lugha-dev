/**
 * Serves the API: an HTTP server for Run, Test, Format and the version,
 * behind Caddy. Every job runs in a fresh sandbox container from
 * `$SANDBOX_IMAGE`. Wiring only: what's worth testing lives in `server` and
 * `checks`.
 *
 * Each connection is its own task, so requests are served at the same time;
 * at most `SANDBOXES` sandboxes run at once, and the rate limit's
 * counts live in one actor.
 *
 * Environment: `SANDBOX_IMAGE` (required: the pinned sandbox image) and
 * `PORT` (default 8080).
 */
import std.http;
import std.json;
import checks.limits { SANDBOXES };
import server.routes { route };
import server.ratelimit { Counts, empty, client_ip };
import server.sandbox { Host, SandboxError, run_in_sandbox };
import server.slots { Slots, free_slots, in_slot };

/** The runner's path inside the sandbox image. */
const RUNNER: string = "/usr/local/bin/runner";

/** Request bodies past this are refused before any route sees them: 512 KB. */
const MAX_BODY_BYTES: i64 = 524288;

/** A `serve` that stops sooner than this after starting couldn't listen, rather than losing a connection. */
const LISTEN_FAILED_MS: i64 = 1000;

/**
 * Runs a job in a sandbox once a slot is free, logging why when there's no
 * result (never the job itself).
 *
 * Errors: the `SandboxError` from `run_in_sandbox`, after logging it.
 */
fun run_logged(
    console: Console,
    host: Host,
    free: Slots,
    image: string,
    job_text: string,
): Result<json.Value, SandboxError> {
    let result = in_slot(free, fun() = run_in_sandbox(host, image, [RUNNER], job_text));
    if let .Err(e) = result {
        console.eprintln("sandbox: {e.debug()}");
    }
    result
}

/** Asks a sandbox for its `lughac --version`, giving "unknown" when it can't answer. */
fun version_of(console: Console, host: Host, image: string): string = match run_in_sandbox(
    host,
    image,
    [RUNNER, "--version"],
    "",
) {
    .Ok(v) => json.get(v, "lughac").and_then(json.as_text).unwrap_or("unknown"),
    .Err(e) => {
        console.eprintln("couldn't ask the sandbox for its version: {e.debug()}");
        "unknown"
    }
};

fun main(
    console: Console,
    env: Env,
    clock: Clock,
    entropy: Entropy,
    net: Net,
    proc: Proc,
    root: Scope,
): i32 {
    let image = env.get("SANDBOX_IMAGE").unwrap_or("");
    if image == "" {
        console.eprintln("SANDBOX_IMAGE must name the sandbox image, such as lugha-sandbox:v0.18.1");
        return 2;
    }
    let port = env.get("PORT").unwrap_or("8080");
    let host = Host { proc: proc, clock: clock, entropy: entropy };
    let version = version_of(console, host, image);
    console.eprintln("serving on :{port} with {image} ({version})");
    let counts = root.spawn(Counts { limiter: empty() });
    let free = free_slots(SANDBOXES);
    let http_limits = http.Limits { body: MAX_BODY_BYTES, ..http.limits() };
    let handler = fun(req: http.Request): http.Response {
        let started = clock.monotonic_ms();
        let answer = route(
            req.method,
            req.path,
            // A body that isn't UTF-8 reads as empty, which is refused as not JSON.
            req.text().unwrap_or(""),
            client_ip(req.headers.get("cf-connecting-ip")),
            clock.now_ms(),
            version,
            fun(ip: string, now_ms: i64) = counts.allowed(ip, now_ms),
            fun(job_text: string) = run_logged(console, host, free, image, job_text),
        );
        // The log has no address and no code: the method, path, status and time.
        console.eprintln(
            "{req.method} {req.path} {answer.status} {clock.monotonic_ms() - started} ms",
        );
        http.json(answer.status, answer.body)
    };
    // `serve` gives up only when it can't listen, or when a connection
    // panicked (it cancels the others first): then it serves again.
    loop {
        let began = clock.monotonic_ms();
        if let .Err(e) = http.serve_with(net, "0.0.0.0:{port}", http_limits, handler) {
            if clock.monotonic_ms() - began < LISTEN_FAILED_MS {
                console.eprintln("couldn't listen on :{port}: {e}");
                return 1;
            }
            console.eprintln("serve stopped: {e}; serving again");
        }
    }
}
