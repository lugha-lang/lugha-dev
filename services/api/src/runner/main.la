/**
 * Runs one job inside a sandbox container: the only program the container
 * starts. It reads one job as JSON on stdin, checks it again, writes the
 * files into its work folder, runs `lughac` and the visitor's program under
 * the limits (`runner.steps`), and prints one JSON result on stdout
 * (`runner.outcome`). Everything untrusted happens here, inside gVisor.
 *
 * Usage: `runner` (it works in the folder it starts in: the container
 * starts it in `/work`, its scratch) or `runner --version`.
 *
 * Wiring only: what's worth testing lives in the package's modules.
 */
import std.json;
import api.checks.files { File };
import api.checks.job { Job, decode };
import api.checks.requests { RunRequest };
import api.runner.steps { Command, build_command, run_command, test_command, format_command };
import api.runner.outcome { Captured, run_result, test_result, format_result, failure, lughac_ran };

/** What a job needs from the world: the work folder and other programs. */
struct World {
    dir: Dir,
    proc: Proc,
}

/**
 * Runs a command with `input` on its stdin and captures what it printed.
 *
 * Errors: a sentence naming the command when it can't be started.
 */
fun capture(w: World, c: Command, input: string): Result<Captured, string> {
    let out = w.proc.run_with(c.cmd, c.args, input).map_err(
        fun(e: string) = "couldn't run {c.cmd}: {e}",
    )?;
    Ok(Captured { code: out.code as i64, stdout: out.stdout, stderr: out.stderr })
}

/** Gives the folder part of a path: `src/a/b.la` → `src/a`; `""` for a top-level file. */
fun folder_of(path: string): string {
    let parts = path.split("/");
    if parts.len < 2 { "" } else { parts.iter().take(parts.len - 1).collect().join("/") }
}

/**
 * Writes the job's files into the current folder, making folders as needed.
 *
 * Errors: a sentence naming the folder or file that couldn't be made or written.
 */
fun write_all(w: World, list: File[]): Result<(), string> {
    for f of list {
        let folder = folder_of(f.path);
        if folder != "" {
            w.dir.make_dirs(folder).map_err(fun(e: string) = "couldn't make {folder}: {e}")?;
        }
        w.dir.write_file(f.path, f.text).map_err(fun(e: string) = "couldn't write {f.path}: {e}")?;
    }
    Ok(())
}

/**
 * Builds the entry and, when it compiled, runs it with the visitor's
 * arguments and stdin, giving back the Run result.
 *
 * Errors: a sentence when a file can't be written, a command can't be
 * started, or `lughac` couldn't finish.
 */
fun do_run(w: World, r: RunRequest): Result<string, string> {
    write_all(w, r.files)?;
    w.dir.make_dirs(".build").map_err(fun(e: string) = "couldn't make .build: {e}")?;
    let build = lughac_ran(capture(w, build_command(r.entry, r.opt), "")?)?;
    if build.code != 0 {
        return Ok(run_result(build, None));
    }
    let program = capture(w, run_command(r.args), r.stdin)?;
    Ok(run_result(build, Some(program)))
}

/**
 * Runs every test and gives back the Test result.
 *
 * Errors: a sentence when a file can't be written, `lughac` can't be started,
 * or it couldn't finish.
 */
fun do_test(w: World, list: File[]): Result<string, string> {
    write_all(w, list)?;
    Ok(test_result(lughac_ran(capture(w, test_command(), "")?)?))
}

/**
 * Formats the `.la` files and gives back the Format result, naming the ones
 * that changed.
 *
 * Errors: a sentence when a file can't be written or read back, `lughac`
 * can't be started, or it couldn't finish.
 */
fun do_format(w: World, list: File[]): Result<string, string> {
    write_all(w, list)?;
    let sources = list.filter(fun(f: File) = f.path.ends_with(".la"));
    let done = lughac_ran(capture(w, format_command(sources.map(fun(f: File) = f.path)), "")?)?;
    let mut after: File[] = [];
    for f of sources {
        let text = w.dir.read_file(f.path).map_err(
            fun(e: string) = "couldn't read {f.path} back: {e}",
        )?;
        after.push(File { path: f.path, text: text });
    }
    Ok(format_result(done, sources, after))
}

/**
 * Does the job read from `input`, in the work folder, and gives back its result.
 *
 * Errors: a sentence when the job can't be read, isn't UTF-8 or fails its
 * checks, or doing it fails.
 */
fun serve(w: World, input: Console): Result<string, string> {
    let bytes = input.read_bytes().map_err(fun(e: string) = "couldn't read the job: {e}")?;
    let text = string_from_utf8(bytes).map_err(fun(e: string) = "the job isn't UTF-8: {e}")?;
    match decode(text)? {
        .Run(r) => do_run(w, r),
        .Test(c) => do_test(w, c.files),
        .Format(c) => do_format(w, c.files),
    }
}

/**
 * Gives the version result: the `lughac` this container has, as
 * `lughac --version` prints it.
 *
 * Errors: a sentence when `lughac` can't be started.
 */
fun lughac_version(proc: Proc): Result<string, string> {
    let out = proc.run("lughac", ["--version"]).map_err(
        fun(e: string) = "couldn't run lughac: {e}",
    )?;
    Ok(
        written(Map {
            "v": json.Value.Integer(1),
            "kind": json.Value.Text("version"),
            "lughac": json.Value.Text(out.stdout.trim()),
        }),
    )
}

fun main(args: string[], console: Console, fs: Fs, proc: Proc) {
    // Always exactly one JSON object on stdout, so the API can always decode it.
    let done = if args.len > 1 && args[1] == "--version" {
        lughac_version(proc)
    } else {
        serve(World { dir: fs.cwd(), proc: proc }, console)
    };
    match done {
        .Ok(result) => console.println(result),
        .Err(why) => console.println(failure(why)),
    }
}

/** Writes a JSON object; every value here is finite, so writing can't fail. */
fun written(fields: Map<string, json.Value>): string = json.stringify(
    json.Value.Object(fields),
).unwrap();
